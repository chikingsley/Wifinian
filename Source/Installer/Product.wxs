<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- This fork is installed for the current user only, without elevation, so that the application
       can install its own updates. It has its own UpgradeCode because a per-user package cannot
       upgrade the per-machine package of the original. -->
  <Package Name="Wifinian" Manufacturer="chikingsley (fork of emoacht)" Version="3.9.0"
           Language="1033" Codepage="1252" Scope="perUser"
           UpgradeCode="{B3236D41-48D3-4642-9EBC-18E30BB7F56B}">
    <SummaryInformation Description="Installer for Wifinian"/>

    <!-- The installed version is removed first so that every file is replaced whatever its file
         version is. A package of the same version replaces the installed one as well.
         It is removed within the transaction of this installation (after InstallInitialize), so
         that the installed version is put back if this installation fails. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed."/>

    <Media Id="1" Cabinet="source.cab" EmbedCab="yes"/>

    <Property Id="VEM" Value="yes"/>

    <!-- The folder chosen in the wizard is remembered so that an upgrade without the wizard
         (/passive) installs to the same folder. -->
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="RememberedInstallDir" Root="HKCU" Key="Software\[ProductName]\Install"
                      Name="InstallDir" Type="raw"/>
    </Property>

    <!-- UI -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR"/>

    <UI>
      <ui:WixUI Id="WixUI_InstallDir"/>
      <UIRef Id="WixUI_ErrorProgressText"/>

      <!-- Skip License Agreement Dialog -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2"/>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2"/>
    </UI>

    <WixVariable Id="WixUIBannerBmp" Value="Resources\banner.png"/>
    <WixVariable Id="WixUIDialogBmp" Value="Resources\dialog.png"/>

    <!-- Programs in Local AppData (per user) -->
    <!-- This is not the working folder of the application (Wifinian in Local AppData) which holds
         the settings, the logs and the database of history. The installer never touches that folder. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLDIR" Name="$(var.Wifinian.ProjectName)"/>
      </Directory>
    </StandardDirectory>

    <!-- Program Menu -->
    <StandardDirectory Id="ProgramMenuFolder"/>

    <!-- A component in the user profile must have a registry value of HKCU as its key path and
         must remove its folders by itself. The files are therefore grouped by folder. The Ids of
         RemoveFolder are numbered from the deepest folder. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MainExecutable" Guid="{0A49DB0E-4F80-4602-B582-33E6E05DFD3B}">
        <File Id="MainExecutable"
              Source="$(var.Wifinian.TargetPath)" Name="$(var.Wifinian.TargetFileName)"/>
        <File Id="MainExecutableConfig"
              Source="$(var.Wifinian.TargetDir)" Name="$(var.Wifinian.TargetFileName).config"/>

        <File Id="BehaviorsLibrary" Source="$(var.Wifinian.TargetDir)" Name="Microsoft.Xaml.Behaviors.dll"/>

        <File Id="RpLibrary" Source="$(var.Wifinian.TargetDir)" Name="ReactiveProperty.dll"/>
        <File Id="RpCoreLibrary" Source="$(var.Wifinian.TargetDir)" Name="ReactiveProperty.Core.dll"/>

        <File Id="RxLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Reactive.dll"/>
        <File Id="RxCoreLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Reactive.Core.dll"/>
        <File Id="RxInterfacesLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Reactive.Interfaces.dll"/>
        <File Id="RxLinqLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Reactive.Linq.dll"/>
        <File Id="RxPlatformServicesLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Reactive.PlatformServices.dll"/>
        <File Id="RxWindowsThreadingLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Reactive.Windows.Threading.dll"/>

        <File Id="ComponentModelAnnotationsLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.ComponentModel.Annotations.dll"/>
        <File Id="RuntimeCompilerServicesUnsafeLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Runtime.CompilerServices.Unsafe.dll"/>
        <File Id="ThreadingTasksExtensionsLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Threading.Tasks.Extensions.dll"/>
        <File Id="ValueTupleLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.ValueTuple.dll"/>

        <File Id="BuffersLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Buffers.dll"/>
        <File Id="MemoryLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Memory.dll"/>
        <File Id="NumericsVectorsLibrary" Source="$(var.Wifinian.TargetDir)" Name="System.Numerics.Vectors.dll"/>

        <!-- SQLite (history database) -->
        <File Id="SqliteLibrary" Source="$(var.Wifinian.TargetDir)" Name="Microsoft.Data.Sqlite.dll"/>
        <File Id="SqliteRawCoreLibrary" Source="$(var.Wifinian.TargetDir)" Name="SQLitePCLRaw.core.dll"/>
        <File Id="SqliteRawBatteriesLibrary" Source="$(var.Wifinian.TargetDir)" Name="SQLitePCLRaw.batteries_v2.dll"/>
        <File Id="SqliteRawProviderLibrary" Source="$(var.Wifinian.TargetDir)" Name="SQLitePCLRaw.provider.dynamic_cdecl.dll"/>

        <File Id="WifiLibrary" Source="$(var.Wifinian.TargetDir)" Name="ManagedNativeWifi.dll"/>
        <File Id="FrameLibrary" Source="$(var.Wifinian.TargetDir)" Name="ScreenFrame.dll"/>
        <File Id="AgencyLibrary" Source="$(var.Wifinian.TargetDir)" Name="StartupAgency.dll"/>

        <!-- Shortcut in Program Menu -->
        <Shortcut Id="ApplicationProgramMenuShortcut" Name="$(var.Wifinian.ProjectName)"
                  Directory="ProgramMenuFolder"
                  Target="[#MainExecutable]" WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon.exe" IconIndex="0">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="[ProductName]"/>
        </Shortcut>

        <RemoveFolder Id="Remove3RuntimesFolder" Directory="RuntimesFolder" On="uninstall"/>
        <RemoveFolder Id="Remove4InstallFolder" Directory="INSTALLDIR" On="uninstall"/>
        <RemoveFolder Id="Remove5ProgramsFolder" Directory="ProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\[ProductName]\Install"
                       Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
      </Component>

      <Component Id="VisualManifest" Guid="{129322FE-BD33-41A2-A55A-931AF5814FA5}"
                 Condition="VEM = &quot;yes&quot;">
        <File Id="VisualManifest"
              Source="$(var.Wifinian.TargetDir)" Name="$(var.Wifinian.TargetName).VisualElementsManifest.xml"/>
        <RegistryValue Root="HKCU" Key="Software\[ProductName]\Install"
                       Name="VisualManifest" Type="integer" Value="1" KeyPath="yes"/>
      </Component>

      <!-- Native libraries of SQLite, found by the architecture of the process -->
      <Directory Id="RuntimesFolder" Name="runtimes">
        <Directory Id="RuntimesX86Folder" Name="win-x86">
          <Directory Id="RuntimesX86NativeFolder" Name="native">
            <Component Id="SqliteNativeX86Library" Guid="{0AAB095C-EA95-4DE4-B5BE-F9AEB2663751}">
              <File Id="SqliteNativeX86Library"
                    Source="$(var.Wifinian.TargetDir)runtimes\win-x86\native\" Name="e_sqlite3.dll" DefaultLanguage="0"/>
              <RemoveFolder Id="Remove1RuntimesX86NativeFolder" Directory="RuntimesX86NativeFolder" On="uninstall"/>
              <RemoveFolder Id="Remove2RuntimesX86Folder" Directory="RuntimesX86Folder" On="uninstall"/>
              <RegistryValue Root="HKCU" Key="Software\[ProductName]\Install"
                             Name="SqliteNativeX86Library" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
          </Directory>
        </Directory>
        <Directory Id="RuntimesX64Folder" Name="win-x64">
          <Directory Id="RuntimesX64NativeFolder" Name="native">
            <Component Id="SqliteNativeX64Library" Guid="{80F0812C-E4CF-441A-856C-D79454657197}">
              <File Id="SqliteNativeX64Library"
                    Source="$(var.Wifinian.TargetDir)runtimes\win-x64\native\" Name="e_sqlite3.dll" DefaultLanguage="0"/>
              <RemoveFolder Id="Remove1RuntimesX64NativeFolder" Directory="RuntimesX64NativeFolder" On="uninstall"/>
              <RemoveFolder Id="Remove2RuntimesX64Folder" Directory="RuntimesX64Folder" On="uninstall"/>
              <RegistryValue Root="HKCU" Key="Software\[ProductName]\Install"
                             Name="SqliteNativeX64Library" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
          </Directory>
        </Directory>
        <Directory Id="RuntimesArm64Folder" Name="win-arm64">
          <Directory Id="RuntimesArm64NativeFolder" Name="native">
            <Component Id="SqliteNativeArm64Library" Guid="{EBA4E269-B100-4060-AA49-0418968C49C3}">
              <File Id="SqliteNativeArm64Library"
                    Source="$(var.Wifinian.TargetDir)runtimes\win-arm64\native\" Name="e_sqlite3.dll" DefaultLanguage="0"/>
              <RemoveFolder Id="Remove1RuntimesArm64NativeFolder" Directory="RuntimesArm64NativeFolder" On="uninstall"/>
              <RemoveFolder Id="Remove2RuntimesArm64Folder" Directory="RuntimesArm64Folder" On="uninstall"/>
              <RegistryValue Root="HKCU" Key="Software\[ProductName]\Install"
                             Name="SqliteNativeArm64Library" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </DirectoryRef>

    <Icon Id="AppIcon.exe" SourceFile="$(var.Wifinian.TargetPath)"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe"/>

    <Feature Id="ProductFeature" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="VisualManifest"/>
      <ComponentRef Id="SqliteNativeX86Library"/>
      <ComponentRef Id="SqliteNativeX64Library"/>
      <ComponentRef Id="SqliteNativeArm64Library"/>
    </Feature>

    <!-- Clean Current User Run -->
    <!-- This is run when uninstalled but not when upgraded, so that the registration to start on
         sign in survives an update. -->
    <CustomAction Id="CleanCurrentUserRun" Directory="TARGETDIR" Execute="immediate" Return="ignore"
                  ExeCommand="[SystemFolder]reg.exe delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v [ProductName] /f"/>
    <InstallExecuteSequence>
      <Custom Action="CleanCurrentUserRun" After="InstallFinalize"
              Condition="(NOT UPGRADINGPRODUCTCODE) AND (REMOVE=&quot;ALL&quot;)"/>
    </InstallExecuteSequence>
  </Package>
</Wix>
